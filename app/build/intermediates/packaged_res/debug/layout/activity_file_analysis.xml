<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/odin_space_md"
    android:background="@drawable/bg_odin_screen">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/file_analysis_title"
        style="@style/Widget.Odin.Text.Title"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="@dimen/odin_space_md" />

    <Button
        android:id="@+id/btn_select_file"
        style="@style/Widget.Odin.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_file" />

    <Button
        android:id="@+id/btn_scan"
        style="@style/Widget.Odin.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scan_file"
        android:enabled="false"
        android:layout_marginTop="@dimen/odin_space_sm" />

    <ProgressBar
        android:id="@+id/progress_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/odin_space_md"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_scan_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_idle"
        style="@style/Widget.Odin.Text.Body"
        android:layout_marginTop="@dimen/odin_space_sm" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/odin_space_md"
        android:background="@drawable/bg_odin_card"
        android:padding="@dimen/odin_space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hash Display Card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hash_information"
                style="@style/Widget.Odin.Text.Title"
                android:textStyle="bold"
                android:paddingBottom="@dimen/odin_space_sm" />

            <TextView
                android:id="@+id/tv_md5_hash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/md5_not_available"
                android:textColor="@color/odin_text_secondary"
                android:textSize="@dimen/odin_text_small" />

            <TextView
                android:id="@+id/tv_sha256_hash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sha256_not_available"
                android:textColor="@color/odin_text_secondary"
                android:textSize="@dimen/odin_text_small" />

            <!-- Metadata Display Card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/metadata"
                style="@style/Widget.Odin.Text.Title"
                android:textStyle="bold"
                android:paddingTop="@dimen/odin_space_md"
                android:paddingBottom="@dimen/odin_space_sm" />

            <TextView
                android:id="@+id/tv_file_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/file_type_not_available"
                android:textColor="@color/odin_text_secondary"
                android:textSize="@dimen/odin_text_small" />

            <TextView
                android:id="@+id/tv_file_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/file_size_not_available"
                android:textColor="@color/odin_text_secondary"
                android:textSize="@dimen/odin_text_small" />

            <!-- Threat Display Card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/threat_information"
                style="@style/Widget.Odin.Text.Title"
                android:textStyle="bold"
                android:paddingTop="@dimen/odin_space_md"
                android:paddingBottom="@dimen/odin_space_sm" />

            <TextView
                android:id="@+id/tv_threat_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/threat_level_not_available"
                android:textColor="@color/odin_text_secondary"
                android:textSize="@dimen/odin_text_small" />

            <TextView
                android:id="@+id/tv_malicious"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/malicious_not_available"
                android:textColor="@color/odin_text_secondary"
                android:textSize="@dimen/odin_text_small" />

            <!-- Analysis Buttons -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/analysis"
                style="@style/Widget.Odin.Text.Title"
                android:textStyle="bold"
                android:paddingTop="@dimen/odin_space_md"
                android:paddingBottom="@dimen/odin_space_sm" />

        <Button
            android:id="@+id/btn_static_analysis"
                style="@style/Widget.Odin.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:text="@string/static_analysis"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_dynamic_analysis"
                style="@style/Widget.Odin.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:text="@string/dynamic_analysis"
            android:enabled="false"
                android:layout_marginTop="@dimen/odin_space_sm" />

        <Button
            android:id="@+id/btn_heuristic_analysis"
                style="@style/Widget.Odin.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:text="@string/heuristic_analysis"
            android:enabled="false"
                android:layout_marginTop="@dimen/odin_space_sm" />

            <!-- Quarantine Button -->
        <Button
            android:id="@+id/btn_quarantine"
                style="@style/Widget.Odin.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:text="@string/quarantine_file"
            android:enabled="false"
                android:layout_marginTop="@dimen/odin_space_md" />

            <!-- Export Button -->
        <Button
            android:id="@+id/btn_export_report"
                style="@style/Widget.Odin.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:text="@string/export_report"
            android:enabled="false"
                android:layout_marginTop="@dimen/odin_space_sm" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
