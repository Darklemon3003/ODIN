<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/odin_space_md"
    android:background="@drawable/bg_odin_screen">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/network_anonymity_title"
        style="@style/Widget.Odin.Text.Title"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="@dimen/odin_space_md" />

    <!-- Overall Status -->
    <TextView
        android:id="@+id/overall_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_inactive"
        android:textSize="@dimen/odin_text_section"
        android:textStyle="bold"
        android:textColor="@color/odin_warning"
        android:gravity="center"
        android:padding="@dimen/odin_space_md"
        android:background="@drawable/bg_odin_state_attention"
        android:layout_marginBottom="@dimen/odin_space_md" />

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="@dimen/odin_space_lg">

        <Button
            android:id="@+id/activate_anonymity_button"
            style="@style/Widget.Odin.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/activate_anonymity"
            android:layout_marginEnd="@dimen/odin_space_sm" />

        <Button
            android:id="@+id/deactivate_anonymity_button"
            style="@style/Widget.Odin.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/deactivate_anonymity"
            android:layout_marginStart="@dimen/odin_space_sm"
            android:enabled="false" />
    </LinearLayout>

    <!-- Status Cards -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_cards_title"
        android:textSize="@dimen/odin_text_section"
        android:textStyle="bold"
        android:textColor="@color/odin_text_primary"
        android:paddingBottom="@dimen/odin_space_sm" />

    <!-- Tor Status Card -->
    <TextView
        android:id="@+id/tor_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tor_status_disconnected"
        android:textSize="@dimen/odin_text_body"
        android:textColor="@color/odin_text_secondary"
        android:padding="@dimen/odin_space_md"
        android:background="@drawable/bg_odin_card"
        android:layout_marginBottom="@dimen/odin_space_sm"
        android:drawableStart="@drawable/ic_odin_notification"
        android:drawablePadding="@dimen/odin_space_sm" />

    <!-- VPN Status Card -->
    <TextView
        android:id="@+id/vpn_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vpn_status_disconnected"
        android:textSize="@dimen/odin_text_body"
        android:textColor="@color/odin_text_secondary"
        android:padding="@dimen/odin_space_md"
        android:background="@drawable/bg_odin_card"
        android:layout_marginBottom="@dimen/odin_space_sm"
        android:drawableStart="@drawable/ic_odin_notification"
        android:drawablePadding="@dimen/odin_space_sm" />

    <!-- Routing Status Card -->
    <TextView
        android:id="@+id/routing_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/routing_status_inactive"
        android:textSize="@dimen/odin_text_body"
        android:textColor="@color/odin_text_secondary"
        android:padding="@dimen/odin_space_md"
        android:background="@drawable/bg_odin_card"
        android:layout_marginBottom="@dimen/odin_space_sm"
        android:drawableStart="@drawable/ic_odin_notification"
        android:drawablePadding="@dimen/odin_space_sm" />

    <!-- DNS Status Card -->
    <TextView
        android:id="@+id/dns_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dns_status_standard"
        android:textSize="@dimen/odin_text_body"
        android:textColor="@color/odin_text_secondary"
        android:padding="@dimen/odin_space_md"
        android:background="@drawable/bg_odin_card"
        android:layout_marginBottom="@dimen/odin_space_sm"
        android:drawableStart="@drawable/ic_odin_notification"
        android:drawablePadding="@dimen/odin_space_sm" />

    <!-- IP Leak Status Card -->
    <TextView
        android:id="@+id/ip_leak_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ip_leak_status_protected"
        android:textSize="@dimen/odin_text_body"
        android:textColor="@color/odin_text_secondary"
        android:padding="@dimen/odin_space_md"
        android:background="@drawable/bg_odin_card"
        android:layout_marginBottom="@dimen/odin_space_lg"
        android:drawableStart="@drawable/ic_odin_notification"
        android:drawablePadding="@dimen/odin_space_sm" />

    <!-- Logs Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/logs_title"
        android:textSize="@dimen/odin_text_section"
        android:textStyle="bold"
        android:textColor="@color/odin_text_primary"
        android:paddingBottom="@dimen/odin_space_sm" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_odin_card"
        android:padding="@dimen/odin_space_sm">

        <LinearLayout
            android:id="@+id/logs_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_logs_available"
                android:textColor="@color/odin_text_muted"
                android:textStyle="italic"
                android:padding="@dimen/odin_space_sm" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
