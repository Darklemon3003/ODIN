<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos críticos para un agente local, persistente y de alta prioridad. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ============================================ -->
    <!-- CUSTOMIZATION: Permisos de Notificación (Sprint 9) -->
    <!-- ============================================ -->

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ============================================ -->
    <!-- NETWORK ANONYMITY: Permisos de Red (Sprint 7) -->
    <!-- ============================================ -->

    <!-- Permisos de red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ============================================ -->
    <!-- FILE ANALYSIS: Permisos de Almacenamiento (Sprint 8) -->
    <!-- ============================================ -->

    <application
        android:name=".OdinApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ODIN"
        android:usesCleartextTraffic="false">

        <activity android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ODIN"
            android:configChanges="orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SentryService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".service.NetShieldVpnService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:stopWithTask="false"
            android:process=":netshield"
            android:foregroundServiceType="specialUse" />

        <!-- ============================================ -->
        <!-- NETWORK ANONYMITY: Services (Sprint 7) -->
        <!-- ============================================ -->

        <!-- Tor Service -->
        <service
            android:name=".network.anonymity.tor.TorService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse" />

        <!-- VPN Service -->
        <service
            android:name=".network.anonymity.vpn.VpnAnonymityService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse" />

        <!-- Network Anonymity Activity -->
        <activity
            android:name=".network.anonymity.ui.NetworkAnonymityActivity"
            android:exported="false"
            android:label="@string/network_anonymity_title"
            android:theme="@style/Theme.ODIN" />

        <!-- ============================================ -->
        <!-- FILE ANALYSIS: Activity (Sprint 8) -->
        <!-- ============================================ -->

        <!-- File Analysis Activity -->
        <activity
            android:name=".fileanalysis.ui.FileAnalysisActivity"
            android:exported="false"
            android:label="@string/file_analysis_title"
            android:theme="@style/Theme.ODIN" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
