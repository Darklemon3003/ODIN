<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos críticos para un agente local, persistente y de alta prioridad. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ============================================ -->
    <!-- CUSTOMIZATION: Permisos de Notificación (Sprint 9) -->
    <!-- ============================================ -->

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ============================================ -->
    <!-- NETWORK ANONYMITY: Permisos de Red (Sprint 7) -->
    <!-- ============================================ -->

    <!-- Permisos de red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ============================================ -->
    <!-- FILE ANALYSIS: Permisos de Almacenamiento (Sprint 8) -->
    <!-- ============================================ -->

    <application
        android:name=".OdinApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ODIN"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ODIN"
            android:configChanges="orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SentryService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled local security event persistence with encrypted AES-256-GCM storage and periodic log rotation via WorkManager, with a continuously visible foreground notification." />
        </service>

        <service
            android:name=".service.NetShieldVpnService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:stopWithTask="false"
            android:process=":netshield"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-authorized local VPN-based network monitoring and packet audit service using Android VpnService, with visible foreground notification. Does not decrypt TLS or inspect private content. Complete traffic forwarding is not guaranteed in this version." />
        </service>

        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
